---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const research = (await getCollection('research')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<Base>
  <section class="hero">
    <img class="portrait" src="/portrait.jpg" alt="Janosch working on a laptop in a field, with a quadruped robot behind him" width="240" height="360" />
    <div class="text">
      <h1>{site.name}</h1>
      <p class="lede">{site.tagline}</p>
      <p>
        I study how quadruped robots can learn adaptive and roboust lcoomotion from raw proprioception —
        and what the representations and motion they learn can tell us about the robot, its behaviour, and the training itself.
      </p>
      <div class="button-row">
        <a href={`mailto:${site.email}`}>Email</a>
        {site.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </div>
  </section>

  <h2>Recent</h2>
  <EntryList base="/research" entries={research} />
  <p style="margin-top:1rem"><a href="/research">All research →</a> · <a href="/teaching">Teaching →</a></p>
</Base>
