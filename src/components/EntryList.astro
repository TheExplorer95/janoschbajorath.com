---
interface Props {
  base: string;
  entries: { id: string; data: { title: string; summary: string; date: Date; venue?: string; kind?: string; format?: string } }[];
}
const { base, entries } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<ul class="entry-list">
  {entries.map((e) => (
    <li>
      <a class="title" href={`${base}/${e.id}`}>{e.data.title}</a>
      <div class="meta">
        {[e.data.kind ?? e.data.format, e.data.venue, fmt(e.data.date)].filter(Boolean).join(' · ')}
      </div>
      <p style="margin:0.4rem 0 0">{e.data.summary}</p>
    </li>
  ))}
</ul>
